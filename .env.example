# CloudVault is a functional simulation of Amazon S3. No AWS account or AWS variables are needed.

# ---- Backend (local development) ----
APP_ENV=development
DATABASE_URL=postgresql+psycopg://cloudvault:cloudvault@localhost:5432/cloudvault
JWT_SECRET=change-me-long-random
JWT_EXPIRE_MINUTES=60
FRONTEND_ORIGIN=http://localhost:5173
MAX_UPLOAD_BYTES=10485760

# Simulated S3 store (PostgreSQL-backed)
STORAGE_BACKEND=postgres
SIM_BUCKET_NAME=cloudvault-sim
SIM_STORAGE_LIMIT_BYTES=314572800   # 300 MiB total across all stored versions
SIM_SIGNING_SECRET=change-me-signing-secret
PUBLIC_API_BASE_URL=http://localhost:8000
PRESIGN_EXPIRY_SECONDS=120

# Document processing worker (durable processing_jobs queue)
PROCESSING_WORKER_ENABLED=true
PROCESSING_POLL_SECONDS=2
MAX_PROCESS_BYTES=5242880

# Recommendation thresholds (CloudVault's heuristic)
REC_MIN_SIZE=131072
REC_MIN_AGE_IA_DAYS=30
REC_GIR_MIN_AGE_DAYS=90
REC_IA_MAX_ACCESSES_90D=2
REC_PROMOTE_ACCESSES_30D=3
REC_COOLDOWN_DAYS=30
PRICING_FILE=./pricing.json         # optional

# Local only: host port for docker-compose Postgres if 5432 is taken
# POSTGRES_PORT=5432

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000
